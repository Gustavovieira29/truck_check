DATABASE_URL=sqlite:///./truck_check.db
APP_ENV=development
CORS_ORIGINS=http://localhost:4173,http://localhost:5173,http://localhost:8443
ADMIN_EMAIL=admin@truckcheck.local
ADMIN_PASSWORD=truckcheck-local-only
# Desenvolvimento: o Docker Compose disponibiliza Mailpit em localhost:1025.
# Veja os e-mails de teste em http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@truckcheck.local
SMTP_USE_TLS=false

# Produção: substitua pelos dados do provedor SMTP e, se necessário, informe:
# SMTP_USERNAME=seu_usuario
# SMTP_PASSWORD=sua_senha_ou_senha_de_app
